<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: white, the blue-lettered logo in
     the middle at 240dp wide. The Flutter splash (HealthProSplash) draws the
     same in the light theme (the app's own until someone picks dark; this
     can't read their choice), so the handover doesn't jump. Android 12+ uses
     values*-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
